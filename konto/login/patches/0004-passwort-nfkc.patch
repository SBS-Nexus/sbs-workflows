diff --git a/apps/login/src/lib/password-normalization.test.ts b/apps/login/src/lib/password-normalization.test.ts
new file mode 100644
index 0000000..347dd66
--- /dev/null
+++ b/apps/login/src/lib/password-normalization.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { normalisierePasswort } from "./password-normalization";
+
+describe("normalisierePasswort (Lernpfade, NFKC wie in den Apps)", () => {
+  it("lässt gewöhnliche Passwörter unverändert", () => {
+    expect(normalisierePasswort("Grüße-aus-Köln-2026")).toBe("Grüße-aus-Köln-2026");
+  });
+
+  it("löst Kompatibilitätsformen auf (Ligatur, Vollbreite)", () => {
+    expect(normalisierePasswort("Proﬁ-Passwort")).toBe("Profi-Passwort");
+    expect(normalisierePasswort("２０２６")).toBe("2026");
+  });
+
+  it("vereinheitlicht zerlegte Umlaute", () => {
+    expect(normalisierePasswort("Köln")).toBe("Köln");
+  });
+
+  it("lässt fehlende Werte fehlen", () => {
+    expect(normalisierePasswort(undefined)).toBeUndefined();
+  });
+});
diff --git a/apps/login/src/lib/password-normalization.ts b/apps/login/src/lib/password-normalization.ts
new file mode 100644
index 0000000..a4263b1
--- /dev/null
+++ b/apps/login/src/lib/password-normalization.ts
@@ -0,0 +1,11 @@
+/**
+ * Lernpfade: Passwörter werden vor dem Prüfen und Setzen nach Unicode NFKC
+ * normalisiert, genau wie die Lernpfade-Apps es beim Hashen tun. Sonst passten
+ * übernommene Hashes nicht, sobald ein Passwort Zeichen mit Kompatibilitätsform
+ * enthält (etwa die Ligatur „ﬁ“ oder Vollbreiten-Ziffern). Siehe E4.0-Bericht.
+ */
+export function normalisierePasswort(passwort: string): string;
+export function normalisierePasswort(passwort: string | undefined): string | undefined;
+export function normalisierePasswort(passwort: string | undefined): string | undefined {
+  return passwort?.normalize("NFKC");
+}
