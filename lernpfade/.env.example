# Öffentliche Ziele der vorhandenen Lernpfade.
# Die Hub-Seite hat selbst keine Konten und keine Datenbank.
NEXT_PUBLIC_PYTHONPFAD_URL=
NEXT_PUBLIC_SQLPFAD_URL=
NEXT_PUBLIC_AIPFAD_URL=

# Solange Git & GitHub noch als Strecke in AIPfad lebt, kann hier dieselbe
# AIPfad-Adresse stehen. Später kann ohne UI-Änderung eine eigene App folgen.
NEXT_PUBLIC_GITPFAD_URL=

# LP-05B: Live-Wiederholungen aus den Apps (schreibgeschützt). Opt-in-Liste
# aus python, sql, ai. Leer = nur das Demo-Deck. Jede genannte App braucht
# zusätzlich ihre URL oben und auf ihrer Seite PLATFORM_HUB_ORIGIN = die
# Origin dieses Hubs. Live-Daten fließen nur, wenn Hub und App same-site sind
# (gemeinsame registrierbare Domain) - siehe docs/LEARNING-PLATFORM.md, Abschnitt 10.
NEXT_PUBLIC_REVIEW_FEDERATION_SOURCES=
