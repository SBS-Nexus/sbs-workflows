# Öffentliche Ziele der vorhandenen Lernpfade.
# Die Hub-Seite hat selbst keine Konten und keine Datenbank; angemeldet wird
# über das gemeinsame Konto (unten, E4.5b).
NEXT_PUBLIC_PYTHONPFAD_URL=
NEXT_PUBLIC_SQLPFAD_URL=
NEXT_PUBLIC_AIPFAD_URL=

# Solange Git & GitHub noch als Strecke in AIPfad lebt, kann hier dieselbe
# AIPfad-Adresse stehen. Später kann ohne UI-Änderung eine eigene App folgen.
NEXT_PUBLIC_GITPFAD_URL=

# LP-05B: Live-Wiederholungen aus den Apps (schreibgeschützt). Opt-in-Liste
# aus python, sql, ai. Leer = nur das Demo-Deck. Jede genannte App braucht
# zusätzlich ihre URL oben und auf ihrer Seite PLATFORM_HUB_ORIGIN = die
# Origin dieses Hubs. Live-Daten fließen nur, wenn Hub und App same-site sind
# (gemeinsame registrierbare Domain) - siehe docs/LEARNING-PLATFORM.md, Abschnitt 10.
NEXT_PUBLIC_REVIEW_FEDERATION_SOURCES=

# --- Anmeldung über das gemeinsame Konto (E4.5b) ----------------------------
# Alle fünf Werte oder keiner (sonst Fehler). Ohne Werte bleibt der Hub ohne
# Anmeldung, /auth/* antwortet mit 404. docs/E4-5-BAUPLAN.md
# Aussteller, https (http nur für localhost), z. B. https://konto.lernpfade.net
AUTH_ISSUER=
# Anwendung „Lernpfade-Hub“ im Projekt „Lernpfade“ (konto/einrichtung).
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Mindestens 32 Zeichen; verschlüsselt die Sitzung im Cookie und signiert den
# Anmeldezustand. Etwa: openssl rand -base64 48
HUB_SESSION_SECRET=
# Öffentliche Adresse des Hubs, z. B. https://www.lernpfade.net
HUB_URL=

# --- Organisationen (E5.1) ---------------------------------------------------
# Postgres der Plattform. Ohne Wert sind Organisationen aus (/organisation und
# /einladung/* antworten mit 404); braucht zusätzlich die Anmeldung oben.
# Migrationen: npm run db:deploy. docs/E5-PLAN.md
DATABASE_URL=

# --- Stand der Teams (E5.2) ---------------------------------------------------
# Maschinenkonto „lernpfade-plattform“ im gemeinsamen Konto (konto/einrichtung,
# plattform-auth.json). Beide oder keiner; ohne sie zeigt die Teamseite keinen
# Stand. Die Apps brauchen dazu AUTH_PLATTFORM_SUB.
PLATTFORM_CLIENT_ID=
PLATTFORM_CLIENT_SECRET=
