# SQLPfad – Vorlage für die Umgebungskonfiguration
#
# Kopieren nach `.env` und ausfüllen. Die echte `.env` ist in .gitignore
# eingetragen und gehört niemals ins Repository.
#
# Alle Werte werden beim Start gegen src/server/env.ts geprüft. Fehlt etwas
# oder ist es unplausibel, bricht die Anwendung mit einer verständlichen
# Meldung ab, statt später mit einem schwer zuzuordnenden Laufzeitfehler.

# ---------------------------------------------------------------------------
# Plattformdatenbank (PostgreSQL)
# ---------------------------------------------------------------------------
# Konten, Sitzungen, Fortschritt, Inhalte. Gegen diese Datenbank führen
# Lernende niemals SQL aus - siehe docs/SQL-RUNNER.md, Abschnitt 2.
#
# Lokal über docker-compose.yml auf 127.0.0.1:5433.
DATABASE_URL=postgresql://sqlpfad:sqlpfad@127.0.0.1:5433/sqlpfad

# ---------------------------------------------------------------------------
# Sitzungen
# ---------------------------------------------------------------------------
# Mindestens 32 Zeichen. Neu erzeugen, niemals aus einer Anleitung übernehmen:
#   openssl rand -base64 48
AUTH_SECRET=

# Die Adresse, unter der diese Installation erreichbar ist - ohne
# abschließenden Schrägstrich. Sie steht in sitemap.xml, robots.txt und in den
# kanonischen Verweisen.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SQL Runner
# ---------------------------------------------------------------------------
# Der Schalter aus docs/SQL-RUNNER.md, Abschnitt 6. Solange die Lizenzfrage
# für den Produktionsbetrieb nicht entschieden ist, bleibt er auf false. Die
# Anwendung erklärt dann sichtbar, dass Abfragen gerade nicht ausgeführt werden
# können. Einen stillen Rückfall auf eine unsichere Ausführung gibt es nicht.
FEATURE_SQL_RUNNER=false

# Adresse und Token des Runner-Dienstes. Die Anwendung spricht nie direkt
# Port 1433 - Begründung in docs/SQL-RUNNER.md, Abschnitt 3.
SQL_RUNNER_URL=
SQL_RUNNER_TOKEN=

# Harte Grenzen je Ausführung. Ohne sie blockiert eine einzige Abfrage den
# Übungsserver für alle - meist aus Versehen, etwa durch einen JOIN ohne
# Bedingung.
SQL_ZEITLIMIT_MS=5000
SQL_MAX_ZEILEN=500
SQL_MAX_ANWEISUNGEN=10

# ---------------------------------------------------------------------------
# Aufbewahrung
# ---------------------------------------------------------------------------
# Wie lange einzelne Lösungsversuche gespeichert bleiben. 0 bedeutet: gar nicht.
ATTEMPT_RETENTION_DAYS=365
