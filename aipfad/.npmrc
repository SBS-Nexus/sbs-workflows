# npm 10.9.8s Arborist wirft beim Auflösen der Peer-Abhängigkeiten von Vitest 4
# (optionale Peers wie @vitest/browser-playwright/msw) einen internen Fehler
# ("Cannot read properties of null (reading 'edgesOut')"). pythonpfad/sqlpfad
# treffen das nicht, weil sie andere Peer-Kombinationen laden. Bis ein
# npm-Update das behebt, hier fest verankert statt bei jeder Installation neu
# zu erraten.
legacy-peer-deps=true
