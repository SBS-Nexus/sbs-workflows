# ---------------------------------------------------------------------------
# AIPfad – Beispielkonfiguration
# Kopiere diese Datei nach `.env` und passe die Werte an.
# `.env` darf niemals in die Versionsverwaltung aufgenommen werden.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# Verbindungszeichenfolge für PostgreSQL. Passend zu docker-compose.yml.
DATABASE_URL="postgresql://aipfad:aipfad@localhost:5433/aipfad?schema=public"

# Separate Datenbank für Integrationstests.
TEST_DATABASE_URL="postgresql://aipfad:aipfad@localhost:5433/aipfad_test?schema=public"

# --- Anwendung -------------------------------------------------------------
# Öffentliche Basis-URL der Anwendung (für sichere Cookies und Redirects).
APP_URL="http://localhost:3000"

# Unveränderliche Kennung dieses Builds/Deployments, z. B. Git-Commit-SHA.
# Lokal genügt ein sprechender Wert; in CI/Produktion pro Release neu setzen.
DEPLOYMENT_ID="lokal"

# Aufbewahrungsfrist für rohe Versuchsdaten in Tagen (Datenschutz).
# 0 deaktiviert die automatische Löschung.
ATTEMPT_RETENTION_DAYS="365"

# --- Beispielkonten --------------------------------------------------------
# Legt beim Seeding ein Beispielkonto an. NUR für die lokale Entwicklung.
# In Produktion wird dieser Schalter grundsätzlich ignoriert.
SEED_DEMO_USERS="true"

# ---------------------------------------------------------------------------
# Hinweis: Diese Ausbaustufe von AIPfad ruft keine externen KI-Anbieter auf.
# Alle Übungen und Labs sind deterministisch. Ein AI-Gateway für spätere
# Live-Funktionen ist in docs/LEHRPLAN.md als nächster Ausbauschritt
# vorgesehen, bewusst noch ohne Umgebungsvariablen hier.
# ---------------------------------------------------------------------------
