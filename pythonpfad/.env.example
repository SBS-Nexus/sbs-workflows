# ---------------------------------------------------------------------------
# PythonPfad – Beispielkonfiguration
# Kopiere diese Datei nach `.env` und passe die Werte an.
# `.env` darf niemals in die Versionsverwaltung aufgenommen werden.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# Verbindungszeichenfolge für PostgreSQL. Passend zu docker-compose.yml.
DATABASE_URL="postgresql://pythonpfad:pythonpfad@localhost:5432/pythonpfad?schema=public"

# Separate Datenbank für Integrationstests (wird bei `npm run test` verwendet).
TEST_DATABASE_URL="postgresql://pythonpfad:pythonpfad@localhost:5432/pythonpfad_test?schema=public"

# --- Sitzungen und Sicherheit ---------------------------------------------
# Zufälliger Schlüssel (mind. 32 Byte) zum Ableiten von Sitzungs- und
# CSRF-Token-Hashes. Erzeugen mit:  openssl rand -base64 48
AUTH_SECRET="bitte-ersetzen-openssl-rand-base64-48"

# Öffentliche Basis-URL der Anwendung (für sichere Cookies und Redirects).
APP_URL="http://localhost:3000"

# Aufbewahrungsfrist für rohe Versuchsdaten in Tagen (Datenschutz).
# 0 deaktiviert die automatische Löschung.
ATTEMPT_RETENTION_DAYS="365"

# --- Beispielkonten --------------------------------------------------------
# Legt beim Seeding die beiden Beispielkonten an, deren Passwörter im
# Repository stehen. NUR für die lokale Entwicklung.
# In Produktion wird dieser Schalter grundsätzlich ignoriert.
SEED_DEMO_USERS="true"

# --- KI-Tutor (optional) ---------------------------------------------------
# Der Tutor läuft standardmäßig REGELBASIERT und komplett offline.
# Nur wenn hier ein Anbieter gesetzt ist UND die Nutzerin bzw. der Nutzer in den
# Einstellungen ausdrücklich einwilligt, werden Daten an einen externen Dienst
# gesendet.
# Mögliche Werte: "rule-based" (Standard) | "anthropic" | "openai-compatible"
AI_TUTOR_PROVIDER="rule-based"

# API-Schlüssel des gewählten Anbieters. NIEMALS mit NEXT_PUBLIC_ präfixen.
AI_TUTOR_API_KEY=""

# Modellbezeichnung des Anbieters.
AI_TUTOR_MODEL="claude-sonnet-5"

# Basis-URL für OpenAI-kompatible Endpunkte (nur bei "openai-compatible").
AI_TUTOR_BASE_URL=""

# Maximale Tutor-Anfragen pro Nutzer und Stunde.
AI_TUTOR_RATE_LIMIT_PER_HOUR="30"

# ---------------------------------------------------------------------------
# Funktionsschalter
# ---------------------------------------------------------------------------
# Ohne Eintrag gilt jeweils der Standard (alles an). Gelesen werden nur die
# ausdrücklichen Werte "true" und "false"; alles andere führt zum Standard.
# Die Schalter liegen bewusst hier und nicht in der Datenbank: Ein Schalter,
# der selbst von der Datenbank abhaengt, hilft genau dann nicht, wenn man ihn
# am dringendsten braucht.

# FEATURE_AUSFUEHRUNGS_VISUALISIERER="true"
# FEATURE_WISSENSLANDKARTE="true"
# FEATURE_ORGANISATIONEN="true"
# FEATURE_EDITOR_VORSCHLAEGE="true"
